<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PowerPlanSwitcher</RootNamespace>
    <AssemblyName>PowerPlanSwitcher</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsFormsHighDpiAutoResizing>true</EnableWindowsFormsHighDpiAutoResizing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>


  <ItemGroup>
    <None Include="..\..\setting.ini" Link="setting.ini" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\icons\Balanced.png" Link="Balanced.png" />
    <EmbeddedResource Include="..\..\icons\HighPerf.png" Link="HighPerf.png" />
    <EmbeddedResource Include="..\..\icons\PowerSaver.png" Link="PowerSaver.png" />
    <EmbeddedResource Include="..\..\icons\UltimatePerf.png" Link="UltimatePerf.png" />
    <EmbeddedResource Include="..\..\icons\Balanced.black.png" Link="Balanced.black.png" />
    <EmbeddedResource Include="..\..\icons\HighPerf.black.png" Link="HighPerf.black.png" />
    <EmbeddedResource Include="..\..\icons\PowerSaver.black.png" Link="PowerSaver.black.png" />
    <EmbeddedResource Include="..\..\icons\UltimatePerf.black.png" Link="UltimatePerf.black.png" />
  </ItemGroup>


  <ItemGroup>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimization>true</Optimization>
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

</Project>
